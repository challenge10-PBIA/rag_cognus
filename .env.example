# Gold no Databricks (somente leitura dos dados). Escolha UM modo de conexão:
#  a) Token: preencha DATABRICKS_HOST + DATABRICKS_TOKEN (o perfil é ignorado).
#  b) Perfil OAuth: deixe host/token vazios e use `databricks auth login --profile <nome>`.
DATABRICKS_CONFIG_PROFILE=serviceUser
DATABRICKS_HOST=          # ex.: https://adb-1234567890123456.7.azuredatabricks.net
DATABRICKS_TOKEN=         # token pessoal (dapi...); fica só no .env, fora do Git
DATABRICKS_WAREHOUSE_ID=  # SQL Warehouse → Connection details → ID
GOLD_VIEW=cognus.gold.vw_rag_conhecimento

# Modelos locais (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3.5:9b
OLLAMA_EMBED_MODEL=embeddinggemma:latest
# Juiz das métricas de resposta. Vazio = mesmo modelo do chat (há viés de autoavaliação).
OLLAMA_JUDGE_MODEL=
RAG_RETRIEVER=bm25
RAG_TOP_K=5

# MLflow open source local (rag-cognus mlflow-local). Porta 5001: a 5000 é do AirPlay no macOS.
MLFLOW_TRACKING_URI=http://127.0.0.1:5001
MLFLOW_EXPERIMENT_NAME=rag-cognus
